# ============================================================
#  RE/MAX Data House — Agente IA para WhatsApp
#  Copiá este archivo a ".env" y completá los valores.
# ============================================================

# --- Modelos (cadena con fallback) ---
# ⚠️ Cargá al menos DOS proveedores: sin fallback, una cuota agotada deja el bot MUDO en producción.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# Usá el modelo Claude vigente (Sonnet para producción). Verificá el ID en https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_MODEL=claude-sonnet-4-5

# Fallback: MISMO modelo, cuenta y saldo aparte (la red de seguridad más barata).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4-5

# Otro fallback opcional:
OPENAI_API_KEY=sk-proj-xxxxxxxx
OPENAI_MODEL=gpt-4o

# Fallback adicional: Google Gemini (tiene free tier). Key: https://aistudio.google.com
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# Cuál encabeza la cadena: anthropic | openrouter | openai | google
AGENT_PRIMARY=anthropic

# Modelo barato para la revisión nocturna (si vacío, usa ANTHROPIC_MODEL):
REVIEW_PROVIDER=anthropic
REVIEW_MODEL=

# --- Supabase (tu proyecto dedicado) ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJI...

# --- Comportamiento del bot ---
MENSAJE_SPLIT_TOKEN=|||
TYPING_MIN_MS=700
TYPING_MAX_MS=2500
DEBOUNCE_MS=2500
MAX_TOOL_ITERATIONS=8
MAX_OUTPUT_TOKENS=1024
AGENT_TEMPERATURE=0.3

# --- Transporte de WhatsApp: baileys (fase pruebas) | cloud (Fase 2, pendiente) ---
WHATSAPP_TRANSPORT=baileys

# --- Sync del catálogo RE/MAX (API directa del CRM) ---
# Credenciales de la agente: el sync se loguea a la API del CRM y baja las propiedades.
REMAX_API_URL=https://api-ar.redremax.com
REMAX_EMAIL=
REMAX_PASSWORD=

# --- Transcripción de audios (opcional): none | groq | openai ---
TRANSCRIPCION_PROVIDER=none
TRANSCRIPCION_API_KEY=

# WhatsApp Cloud API (Meta) — para numeros oficiales. Por agente va en business_info.cloud; esto es el fallback de un solo numero.
WHATSAPP_TRANSPORT=baileys   # baileys | cloud (global; se puede override por agente)
WHATSAPP_GRAPH_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_VERIFY_TOKEN=
